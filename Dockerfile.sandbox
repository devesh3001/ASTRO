# Separate runtime identities; the verifier is never copied into this image.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
RUN groupadd -g 1001 agentgroup && useradd -u 1001 -g agentgroup -M sandbox-agent \
 && groupadd -g 1002 evalgroup && useradd -u 1002 -g evalgroup -M sandbox-eval \
 && mkdir -p /workspace /run/aerosentinel && chmod 700 /run/aerosentinel
COPY sandbox /opt/sandbox
WORKDIR /opt
ENV PYTHONUNBUFFERED=1 REQUIRE_SANDBOX_USERS=1
EXPOSE 8000
CMD ["python", "-m", "sandbox.server"]
