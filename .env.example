# Copy this to .env, fill in the values, then:
#   docker compose up --build --abort-on-container-exit --exit-code-from harness

# Model name, API key and base URL arrive in the API key email.
# Leave as mock/solver to run offline with no API key (also: mock/idle).
MODEL=mock/solver
API_KEY=
BASE_URL=

# Which task to run, and the seed used at reset.
# Tasks: power_brownout, adcs_wheel_bias, thermal_runaway, comms_link_budget, multi_fault_cascade
TASK_ID=power_brownout
SEED=0

# full      = baseline checks, then model run on TASK_ID (default)
# all       = baseline checks for every task, then model on every task in turn
# baselines = baseline checks for every task, no model call
MODE=full

# Optional: extra instructions appended to the system prompt exactly as written.
# Put the file in inputs/ and name it here (e.g. APPEND_FILE=inputs/extra.txt).
# A named file that is missing or empty stops the run.
APPEND_FILE=

# Optional: cap model reply length (leave empty for model default).
MAX_TOKENS=
